<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/customerListFragment">

    <fragment
        android:id="@+id/customerListFragment"
        android:name="com.example.tiffin.ui.CustomerListFragment"
        android:label="@string/app_name"
        tools:layout="@layout/fragment_customer_list">
        <action
            android:id="@+id/action_customerList_to_customerDetails"
            app:destination="@id/customerDetailsFragment" />
    </fragment>

    <fragment
        android:id="@+id/customerDetailsFragment"
        android:name="com.example.tiffin.ui.CustomerDetailsFragment"
        android:label="@string/app_name"
        tools:layout="@layout/fragment_customer_details">
        <argument
            android:name="customerId"
            app:argType="long" />
        <action
            android:id="@+id/action_customerDetails_to_paymentHistory"
            app:destination="@id/paymentHistoryFragment" />
    </fragment>

    <fragment
        android:id="@+id/paymentHistoryFragment"
        android:name="com.example.tiffin.ui.PaymentHistoryFragment"
        android:label="@string/app_name"
        tools:layout="@layout/fragment_payment_history">
        <argument
            android:name="customerId"
            app:argType="long" />
    </fragment>

</navigation>

